{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1 · Install dependencies",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt -r requirements-dev.txt",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "2 · Seed demo database",
      "type": "shell",
      "command": "python -m app.seed --reset",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "3 · Run server",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      },
      "isBackground": false
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python -m pytest -q",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Reset database",
      "type": "shell",
      "command": "python -c \"from pathlib import Path; [p.unlink() for p in Path('data').glob('app.db*')] if Path('data').exists() else None\"",
      "problemMatcher": []
    },
    {
      "label": "Health check",
      "type": "shell",
      "command": "curl -s http://127.0.0.1:8000/api/health",
      "problemMatcher": []
    }
  ]
}